[ext_resource type="PackedScene" path="res://effects/overdrive_burst.tscn" id="2_burst"]
[ext_resource type="Script" path="res://scripts/visuals/visual_profile.gd" id="3_profile"]

[sub_resource type="Resource" id="Cue_level_up"]
