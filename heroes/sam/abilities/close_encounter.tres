[ext_resource type="Script" path="res://scripts/stats/scaling_value.gd" id="9_v"]

[sub_resource type="Resource" id="Targeting"]
script = ExtResource("6_a")
cast_range = 700.0
snap_radius = 150.0
requires_line_of_sight = false
accepts = 0

[sub_resource type="Resource" id="Telegraph"]
script = ExtResource("9_v")
