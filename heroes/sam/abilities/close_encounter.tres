[resource]
script = ExtResource("1_a")
minigame = ExtResource("3_a")
abducted_status = ExtResource("4_a")
daze_status = ExtResource("5_a")
id = &"close_encounter"
display_name = "Close Encounter"
description = "Beam up an enemy within 700 px (0.4 s to land: they can dodge it). They play the airlock maze while you fly the UFO toward your cursor; you can move and shoot but cast nothing else. When they get out (or at 4 s) they drop wherever the UFO is, dazed for 0.3 s."
ability_script = ExtResource("2_a")
cooldown = 80.0
ally_targeting = SubResource("Targeting")
tags = Array[StringName]([&"ultimate"])
values = Dictionary[StringName, ExtResource("9_v")]({
&"telegraph": SubResource("Telegraph"),
&"beam_radius": SubResource("Beam"),
&"ufo_speed": SubResource("Ufo")
})
feel_preset = &"quick"
