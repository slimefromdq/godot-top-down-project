[sub_resource type="Resource" id="Sub_stats"]
script = ExtResource("2_x")
health = SubResource("Sub_health")
weapon = SubResource("Sub_weapon")
magic = SubResource("Sub_magic")
armor = SubResource("Sub_armor")
magic_resist = SubResource("Sub_mr")

[resource]
script = ExtResource("1_x")
hero_id = &"sam"
display_name = "Sam"
title = "The Visitor"
role = 2
description = "An alien trying to make friends; his affection is the disable. Most of his abilities work on anyone: allies get something nice, enemies get held. His UFO takes one enemy away and drops them somewhere else."
stats = SubResource("Sub_stats")
move_speed = 540.0
acceleration = 2600.0
friction = 2800.0
abilities = Dictionary[StringName, ExtResource("4_x")]({
&"primary": ExtResource("5_x"),
&"ability_1": ExtResource("6_x"),
&"movement": ExtResource("7_x"),
&"cc": ExtResource("8_x"),
&"ultimate": ExtResource("9_x")
})
feel_profile = ExtResource("11_x")
visual_profile = ExtResource("12_x")
