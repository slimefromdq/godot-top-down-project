[resource]
script = ExtResource("1_x")
hero_id = &"avery"
display_name = "Avery"
title = "the Sunblade"
role = 0
description = "A valiant knight with a flaming sword. Consistent at every level, with strong late-game sustain. Blade damage scales with Weapon; fire and healing scale with Magic. Her burns, brands and ultimate flames hurt for true damage, so a hero who runs still burns."
stats = SubResource("Sub_6")
move_speed = 486.0
acceleration = 2600.0
friction = 2800.0
abilities = Dictionary[StringName, ExtResource("4_x")]({
&"primary": ExtResource("5_x"),
&"ability_1": ExtResource("6_x"),
&"movement": ExtResource("7_x"),
&"cc": ExtResource("8_x"),
&"ultimate": ExtResource("9_x")
})
feel_profile = ExtResource("10_x")
visual_profile = ExtResource("11_x")
audio_profile = ExtResource("12_x")
