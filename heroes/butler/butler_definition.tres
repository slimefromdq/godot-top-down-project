[sub_resource type="Resource" id="Sub_health"]
script = ExtResource("3_x")
base = 900.0
growth = 94.4444

[sub_resource type="Resource" id="Sub_weapon"]
script = ExtResource("3_x")
base = 38.0
growth = 4.4444

[sub_resource type="Resource" id="Sub_magic"]
script = ExtResource("3_x")
base = 20.0
growth = 2.7778

[sub_resource type="Resource" id="Sub_armor"]
script = ExtResource("3_x")
base = 38.0
growth = 3.5556

[sub_resource type="Resource" id="Sub_mr"]
script = ExtResource("3_x")
base = 30.0
growth = 2.4444

[sub_resource type="Resource" id="Sub_stats"]
script = ExtResource("2_x")
health = SubResource("Sub_health")
weapon = SubResource("Sub_weapon")
magic = SubResource("Sub_magic")
armor = SubResource("Sub_armor")
magic_resist = SubResource("Sub_mr")

[resource]
script = ExtResource("1_x")
hero_id = &"butler"
display_name = "Butler"
title = "The Composed"
role = 0
description = "Two heroes in one body: a protective tank while Composed, a lifestealing bruiser while Starving. Hunger fills as he tanks; at the top, the gloves come off."
stats = SubResource("Sub_stats")
move_speed = 510.0
acceleration = 2400.0
friction = 2800.0
abilities = Dictionary[StringName, ExtResource("4_x")]({
&"primary": ExtResource("5_x"),
&"ability_1": ExtResource("6_x"),
&"movement": ExtResource("7_x"),
&"cc": ExtResource("8_x"),
&"ultimate": ExtResource("9_x"),
&"passive": ExtResource("10_x")
})
feel_profile = ExtResource("11_x")
visual_profile = ExtResource("12_x")
