[gd_resource type="Resource" script_class="HeroDefinition" format=3]

[ext_resource type="Script" path="res://scripts/heroes/hero_definition.gd" id="1_x"]
[ext_resource type="Script" path="res://scripts/stats/stat_block.gd" id="2_x"]
[ext_resource type="Script" path="res://scripts/stats/stat_scaling.gd" id="3_x"]
[ext_resource type="Script" path="res://scripts/abilities/ability_data.gd" id="4_x"]
[ext_resource type="Resource" path="res://heroes/cpt_yellow/abilities/stinger_volley.tres" id="5_x"]
[ext_resource type="Resource" path="res://heroes/cpt_yellow/abilities/swarm_ride.tres" id="6_x"]
[ext_resource type="Resource" path="res://heroes/cpt_yellow/abilities/rally.tres" id="7_x"]
[ext_resource type="Resource" path="res://heroes/cpt_yellow/abilities/sting.tres" id="8_x"]
[ext_resource type="Resource" path="res://heroes/cpt_yellow/abilities/charge.tres" id="9_x"]
[ext_resource type="Resource" path="res://heroes/cpt_yellow/cpt_yellow_feel.tres" id="10_x"]
[ext_resource type="Resource" path="res://heroes/cpt_yellow/cpt_yellow_visuals.tres" id="11_x"]
[ext_resource type="Resource" path="res://heroes/cpt_yellow/cpt_yellow_audio.tres" id="12_x"]

[sub_resource type="Resource" id="Sub_health"]
script = ExtResource("3_x")
base = 1100.0
growth = 130.0

[sub_resource type="Resource" id="Sub_weapon"]
script = ExtResource("3_x")
base = 40.0
growth = 3.5

[sub_resource type="Resource" id="Sub_magic"]
script = ExtResource("3_x")
base = 20.0
growth = 2.0

[sub_resource type="Resource" id="Sub_armor"]
script = ExtResource("3_x")
base = 45.0
growth = 4.5

[sub_resource type="Resource" id="Sub_mr"]
script = ExtResource("3_x")
base = 35.0
growth = 3.0

[sub_resource type="Resource" id="Sub_stats"]
script = ExtResource("2_x")
health = SubResource("Sub_health")
weapon = SubResource("Sub_weapon")
magic = SubResource("Sub_magic")
armor = SubResource("Sub_armor")
magic_resist = SubResource("Sub_mr")

[resource]
script = ExtResource("1_x")
hero_id = &"cpt_yellow"
display_name = "Cpt. Yellow"
title = "Yellow Army"
role = 0
description = "A small commander riding an army of yellow bugs. Dive tank: ride the swarm in, rally the army into a shield when focused, sting a target to stick to it, and sound the CHARGE! to sweep a whole team away. High health and health growth."
stats = SubResource("Sub_stats")
move_speed = 500.0
acceleration = 2400.0
friction = 2600.0
abilities = Dictionary[StringName, ExtResource("4_x")]({
&"primary": ExtResource("5_x"),
&"ability_1": ExtResource("6_x"),
&"movement": ExtResource("7_x"),
&"cc": ExtResource("8_x"),
&"ultimate": ExtResource("9_x")
})
feel_profile = ExtResource("10_x")
visual_profile = ExtResource("11_x")
audio_profile = ExtResource("12_x")
