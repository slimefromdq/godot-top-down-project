[resource]
script = ExtResource("1_a")
distance = 300.0
speed = 1800.0
carry_momentum = false
id = &"there_you_are"
display_name = "There You Are"
description = "Blink to just behind your Beloved if they're within 900 px. No line of sight needed. With no Beloved, a short dash."
