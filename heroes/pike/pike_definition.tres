[gd_resource type="Resource" script_class="HeroDefinition" format=3]

[ext_resource type="Script" path="res://scripts/heroes/hero_definition.gd" id="1_x"]
[ext_resource type="Script" path="res://scripts/stats/stat_block.gd" id="2_x"]
[ext_resource type="Script" path="res://scripts/stats/stat_scaling.gd" id="3_x"]
[ext_resource type="Script" path="res://scripts/abilities/ability_data.gd" id="4_x"]
[ext_resource type="Resource" path="res://heroes/pike/abilities/juggled_knives.tres" id="5_x"]
[ext_resource type="Resource" path="res://heroes/pike/abilities/beloved.tres" id="6_x"]
[ext_resource type="Resource" path="res://heroes/pike/abilities/there_you_are.tres" id="7_x"]
[ext_resource type="Resource" path="res://heroes/pike/abilities/dont_go.tres" id="8_x"]
[ext_resource type="Resource" path="res://heroes/pike/abilities/only_us.tres" id="9_x"]
[ext_resource type="Resource" path="res://heroes/pike/abilities/obsession.tres" id="10_x"]
[ext_resource type="Resource" path="res://heroes/pike/pike_feel.tres" id="11_x"]
[ext_resource type="Resource" path="res://heroes/pike/pike_visuals.tres" id="12_x"]
[ext_resource type="Resource" path="res://heroes/pike/pike_audio.tres" id="20_audio"]

[sub_resource type="Resource" id="Sub_health"]
script = ExtResource("3_x")
base = 504.0
growth = 49.0

[sub_resource type="Resource" id="Sub_weapon"]
script = ExtResource("3_x")
base = 40.0
growth = 6.1111

[sub_resource type="Resource" id="Sub_magic"]
script = ExtResource("3_x")
base = 10.0
growth = 0.8889

[sub_resource type="Resource" id="Sub_armor"]
script = ExtResource("3_x")
base = 18.0
growth = 1.7778

[sub_resource type="Resource" id="Sub_mr"]
script = ExtResource("3_x")
base = 16.0
growth = 1.3333

[sub_resource type="Resource" id="Sub_stats"]
script = ExtResource("2_x")
health = SubResource("Sub_health")
weapon = SubResource("Sub_weapon")
magic = SubResource("Sub_magic")
armor = SubResource("Sub_armor")
magic_resist = SubResource("Sub_mr")

[resource]
script = ExtResource("1_x")
hero_id = &"pike"
display_name = "Pike"
title = "The Beloved's Shadow"
role = 2
description = "Picks one enemy and makes sure it's just the two of them. She can reach her Beloved from almost anywhere, and hits hardest when they can't see her coming."
stats = SubResource("Sub_stats")
move_speed = 504.0
acceleration = 2800.0
friction = 3000.0
abilities = Dictionary[StringName, ExtResource("4_x")]({
&"primary": ExtResource("5_x"),
&"ability_1": ExtResource("6_x"),
&"movement": ExtResource("7_x"),
&"cc": ExtResource("8_x"),
&"ultimate": ExtResource("9_x"),
&"passive": ExtResource("10_x")
})
feel_profile = ExtResource("11_x")
visual_profile = ExtResource("12_x")
audio_profile = ExtResource("20_audio")
