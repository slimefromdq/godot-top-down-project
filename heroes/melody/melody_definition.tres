[resource]
script = ExtResource("1_def")
hero_id = &"melody"
display_name = "Melody"
title = "Living Doll"
description = "A ball-jointed doll brought to life by passion: a marching-band girl with a huge contra tuba. Playing winds the key in her back, and the wound spring powers her encores."
