[gd_resource type="Resource" script_class="HeroDefinition" format=3]

[ext_resource type="Script" path="res://scripts/heroes/hero_definition.gd" id="1_x"]
[ext_resource type="Script" path="res://scripts/stats/stat_block.gd" id="2_x"]
[ext_resource type="Script" path="res://scripts/stats/stat_scaling.gd" id="3_x"]
[ext_resource type="Script" path="res://scripts/abilities/ability_data.gd" id="4_x"]
[ext_resource type="Resource" path="res://heroes/tilly/abilities/bouncy_balls.tres" id="5_x"]
[ext_resource type="Resource" path="res://heroes/tilly/abilities/trampoline.tres" id="6_x"]
[ext_resource type="Resource" path="res://heroes/tilly/abilities/cartwheel.tres" id="7_x"]
[ext_resource type="Resource" path="res://heroes/tilly/abilities/all_eyes_on_me.tres" id="8_x"]
[ext_resource type="Resource" path="res://heroes/tilly/abilities/safety_net.tres" id="9_x"]
[ext_resource type="Resource" path="res://heroes/tilly/abilities/crumple_zone.tres" id="10_x"]
[ext_resource type="Resource" path="res://heroes/tilly/tilly_feel.tres" id="11_x"]
[ext_resource type="Resource" path="res://heroes/tilly/tilly_visuals.tres" id="12_x"]
[ext_resource type="Resource" path="res://heroes/tilly/tilly_audio.tres" id="20_audio"]

[sub_resource type="Resource" id="Sub_health"]
script = ExtResource("3_x")
base = 580.0
growth = 60.0

[sub_resource type="Resource" id="Sub_weapon"]
script = ExtResource("3_x")
base = 30.0
growth = 3.3333

[sub_resource type="Resource" id="Sub_magic"]
script = ExtResource("3_x")
base = 40.0
growth = 6.6667

[sub_resource type="Resource" id="Sub_armor"]
script = ExtResource("3_x")
base = 20.0
growth = 2.0

[sub_resource type="Resource" id="Sub_mr"]
script = ExtResource("3_x")
base = 22.0
growth = 2.0

[sub_resource type="Resource" id="Sub_stats"]
script = ExtResource("2_x")
health = SubResource("Sub_health")
weapon = SubResource("Sub_weapon")
magic = SubResource("Sub_magic")
armor = SubResource("Sub_armor")
magic_resist = SubResource("Sub_mr")

[resource]
script = ExtResource("1_x")
hero_id = &"tilly"
display_name = "Tilly"
title = "The Crash Test Acrobat"
role = 3
description = "A crash-test dummy with a performer's grace. Supports by moving her team, not healing it: trampolines send allies over walls, a dazzling spin makes enemies come to her, and her safety net catches anyone who would die."
stats = SubResource("Sub_stats")
move_speed = 540.0
acceleration = 2600.0
friction = 2800.0
abilities = Dictionary[StringName, ExtResource("4_x")]({
&"primary": ExtResource("5_x"),
&"ability_1": ExtResource("6_x"),
&"movement": ExtResource("7_x"),
&"cc": ExtResource("8_x"),
&"ultimate": ExtResource("9_x"),
&"passive": ExtResource("10_x")
})
feel_profile = ExtResource("11_x")
visual_profile = ExtResource("12_x")
audio_profile = ExtResource("20_audio")
